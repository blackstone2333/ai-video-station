# 服务
PORT=16666
BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=5
TIMEZONE=Asia/Shanghai
DATA_DIR=/data
PUID=1000
PGID=1000

# 6v 站点；服务会自动探测主站、备用站和地址发布页
SIXV_BASE_URL=https://www.6vw.cc
SIXV_FALLBACK_URLS=https://www.6vdyy.com,https://www.6v520.cc,https://www.xb6v.com,https://www.6vhao.tv,https://www.6vgood.net
SIXV_ADDRESS_PAGE=https://www.6v123.net
REQUEST_TIMEOUT_SECONDS=15
SEARCH_DETAIL_LIMIT=20

# 下载器：qbittorrent 或 transmission
DOWNLOADER_TYPE=qbittorrent

# qBittorrent（使用 Transmission 时可留空）
QB_HOST=192.168.31.10
QB_PORT=8080
QB_USERNAME=admin
QB_PASSWORD=replace-me
QB_USE_HTTPS=false
QB_VERIFY_SSL=true
QB_MOVIE_CATEGORY=Movie
QB_TV_CATEGORY=TV
QB_ANIME_CATEGORY=Anime
QB_CUSTOM_CATEGORY=Custom
QB_NAMING_CATEGORY=Media-Naming

# Transmission（使用 qBittorrent 时可留空）
TRANSMISSION_HOST=
TRANSMISSION_PORT=9091
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
TRANSMISSION_USE_HTTPS=false
TRANSMISSION_VERIFY_SSL=true
TRANSMISSION_RPC_PATH=/transmission/rpc

# 首次启动时的四类默认目录；之后可在后台为每类增加多条“源目录 → 目标目录”映射
DOWNLOADS_BASE_PATH=/volume1/video/Downloads
DOWNLOAD_MOVIE_PATH=/volume1/video/Downloads/Movie
DOWNLOAD_TV_PATH=/volume1/video/Downloads/TV
DOWNLOAD_ANIME_PATH=/volume1/video/Downloads/Anime
DOWNLOAD_CUSTOM_PATH=/volume1/video/Downloads/Custom

# 监听与追更
WATCHLIST_CHECK_HOURS=12
WATCHLIST_EXPIRE_DAYS=14
SCHEDULER_ENABLED=true

# Emby 规范化命名
NAMING_ENABLED=true
NAMING_CHECK_MINUTES=1
NAMING_MAX_ATTEMPTS=10

# 硬链接到媒体库（源和目标需在同一文件系统）
# MEDIALIB_BASE_PATH 会整体挂载到容器 /medialib
MEDIALIB_BASE_PATH=/volume1/video
MEDIALIB_MOVIE_PATH=/volume1/video/video/movies
MEDIALIB_TV_PATH=/volume1/video/video/tv
MEDIALIB_ANIME_PATH=/volume1/video/video/anime
MEDIALIB_CUSTOM_PATH=/volume1/video/video/custom
MEDIALIB_HARDLINK_ENABLED=true

# 必须替换为随机长字符串；空值或示例值会拒绝全部 /api 请求
API_KEY=replace-with-a-long-random-string
# 仅在完全隔离且可信的局域网中，才可显式改为 true 以关闭鉴权
ALLOW_INSECURE_LAN=false
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
MAX_TORRENT_UPLOAD_BYTES=8388608
AGENT_OFFLINE_MINUTES=10
